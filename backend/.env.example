# ──────────────────────────────────────────────
# Web Intelligence – Backend Environment Variables
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

# Server
PORT=8000
NODE_ENV=production
FRONTEND_URL=http://localhost:5173

# JWT (change to a long random string in production)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/web_intelligence?retryWrites=true&w=majority

# TextBelt SMS (free tier: key = "textbelt", 1 SMS/day)
# Buy credits at https://textbelt.com for production
TEXTBELT_KEY=textbelt

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Gemini AI
GEMINI_API_KEY=

# Admin seed account (created on first launch if not exists)
ADMIN_EMAIL=admin@webintelligence.local
ADMIN_PASSWORD=changeme123
